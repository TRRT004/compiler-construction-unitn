// EXPECT: 19
// Tests do while with a nested for loop:
// 1. A basic do while with nested for
// 2. A do while with a nested for that returns early.

do_while_with_for() : int {
    total : int = 0
    i : int = 0

    do {
        i = i + 1

        for j: int = 0; j < 3; j = j + 1 {
            total = total + 1
            i = i + 1
        }
    } while (i < 5)

    return total
}

do_while_for_early_return() : int {
    total : int = 0
    i : int = 0

    do {
        i = i + 1

        for j: int = 0; j < 3; j = j + 1 {
            if (total == 9) {
                return total + i
            }

            total = total + 1
        }
    } while (i < 5)

    return total
}

main() : int {
    return do_while_with_for() + do_while_for_early_return()
}