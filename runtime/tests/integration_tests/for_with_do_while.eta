// EXPECT: 54
// Tests for loops with a nested do while:
// 1. A basic for with nested do while
// 2. A nested do while that returns early.

for_with_do_while() : int {
    total : int = 0

    for i: int = 1; i <= 3; i = i + 1 {
        j : int = 0
        do {
            j = j + 1
            total = total + i
        } while (j < 2)
    }

    return total
}

for_do_while_return() : int {
    total : int = 0

    for i: int = 0; i < 5; i = i + 1 {
        j : int = 0

        do {
            j = j + 1

            if (i == 2) {
                return 42
            }

            total = total + 1
        } while (j < 2)
    }

    return total
}


main() : int {
    return for_with_do_while() + for_do_while_return()
}