// EXPECT: 566
// Tests various scenarios for desugared `for` loops:
// 1. Standard forward accumulation (type `Unit` body running multiple iterations)
// 2. Zero iterations when guard is initially false (falls through without executing body or step)
// 3. Lexical scope of `<init>` across sequential loops (re-declaring loop variables without collision)
// 4. Scope isolation of `<body>` (shadowing loop variable inside body does not alter `<step>`)
// 5. Assignment in `<init>` (using pre-existing variable) and multi-variable assignment in `<step>`
// 6. Nested `for` loops with independent counters

test_accumulation(n : int) : int {
    sum : int = 0
    for i: int = 1; i <= n; i = i + 1 {
        sum = sum + i
    }
    return sum
}

test_zero_iterations() : int {
    sum : int = 15
    for i: int = 5; i < 2; i = i + 1 {
        sum = sum + 100
    }
    return sum
}

test_sequential_scope() : int {
    res : int = 0
    for i: int = 0; i < 3; i = i + 1 {
        res = res + i
    }
    // i is out of scope here; declaring i again in a subsequent for loop must succeed
    for i: int = 0; i < 4; i = i + 1 {
        res = res + (i * 10)
    }
    return res
}

test_body_shadowing() : int {
    acc : int = 0
    for i: int = 0; i < 4; i = i + 1 {
        i : int = 100
        acc = acc + i
    }
    return acc
}

test_assign_init_and_multi_step() : int {
    k : int = 0
    step_acc : int = 0
    for k = 1; k <= 4; k, step_acc = k + 1, step_acc + 2 {
    }
    return k + step_acc
}

test_nested_loops() : int {
    total : int = 0
    for r: int = 1; r <= 3; r = r + 1 {
        for c: int = 1; c <= 4; c = c + 1 {
            total = total + (r * c)
        }
    }
    return total
}

main() : int {
    return test_accumulation(5) +
           test_zero_iterations() +
           test_sequential_scope() +
           test_body_shadowing() +
           test_assign_init_and_multi_step() +
           test_nested_loops()
}
